{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun run \"${CLAUDE_PLUGIN_ROOT}/src/aws_guard.ts\" 2>>\"$HOME/.claude/aws-audit.log\" || { echo 'aws_guard failed' >&2; exit 2; }",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
