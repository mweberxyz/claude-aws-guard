{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun run \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/aws_guard.ts 2>>\"$HOME/.claude/aws-audit.log\" || { echo 'aws_guard failed' >&2; exit 2; }",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(aws iam:*)",
      "Bash(aws organizations:*)",
      "Bash(aws sts assume-role:*)",
      "Bash(aws configure:*)",
      "Bash(aws secretsmanager get-secret-value:*)"
    ]
  }
}
